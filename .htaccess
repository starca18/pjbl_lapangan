# --- Security Hardening ---
# Block access to hidden files, dot files, and sensitive extensions
<FilesMatch "^\.|\.(env|sql|json|lock|md|xml|yml|yaml|dist)$|^(spark|builds|composer)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't touch existing files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
